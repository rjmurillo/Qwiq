<Project>
  <!-- Common assembly metadata for all projects -->
  <PropertyGroup>
    <Company>Microsoft Corporation</Company>
    <Product>Microsoft® Quick Work Item Queries</Product>
    <Copyright>© Microsoft Corporation. All rights reserved.</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    
    <!-- COM and CLS compliance -->
    <ComVisible>false</ComVisible>
    <CLSCompliant>true</CLSCompliant>
    
    <!-- Configuration-based assembly configuration -->
    <AssemblyConfiguration>$(Configuration)</AssemblyConfiguration>
    
    <!-- Enable deterministic builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
    
    <!-- Don't auto-generate these attributes since they're in individual AssemblyInfo.cs files -->
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
    <GenerateGuidAttribute>false</GenerateGuidAttribute>
  </PropertyGroup>

  <!-- Assembly metadata for ImplicitNullability (ReSharper) -->
  <ItemGroup>
    <AssemblyMetadata Include="ImplicitNullability.AppliesTo" Value="InputParameters, RefParameters, OutParametersAndResult, Fields" />
    <AssemblyMetadata Include="ImplicitNullability.Fields" Value="RestrictToReadonly, RestrictToReferenceTypes" />
  </ItemGroup>

  <!-- InternalsVisibleTo for testing and mocking -->
  <ItemGroup>
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" PublicKey="" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!-- Include ReSharper annotations for all source projects -->
  <ItemGroup Condition="'$(MSBuildProjectDirectory)' != '$(MSBuildThisFileDirectory)' and '$(IsTestProject)' != 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)src\ReSharper.Annotations.cs" Link="Properties\ReSharper.Annotations.cs" Condition="Exists('$(MSBuildThisFileDirectory)src\ReSharper.Annotations.cs')" />
  </ItemGroup>
</Project>
