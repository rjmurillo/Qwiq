<Project>
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
  </PropertyGroup>

  <!-- Import Artifacts.props early to establish artifact paths before SDK-driven defaults -->
  <Import Project="$(MSBuildThisFileDirectory)build/targets/artifacts/Artifacts.props" Condition="Exists('$(MSBuildThisFileDirectory)build/targets/artifacts/Artifacts.props')" />

  <PropertyGroup>
    <!--
      All projects define TargetFramework(s) in their own .csproj files.
      Do NOT set a TargetFramework default here: the SDK's cross-targeting check
      (IsCrossTargetingBuild = TargetFrameworks != '' AND TargetFramework == '')
      requires TargetFramework to be empty for DispatchToInnerBuilds to fire.
    -->
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Build Configuration -->
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>

    <!-- Compiler Settings -->
    <FileAlignment>512</FileAlignment>
    <HighEntropyVA>true</HighEntropyVA>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <!-- TreatWarningsAsErrors is controlled by PedanticMode (see Directory.Build.targets) -->
    <!-- Analyzer diagnostic severities are configured in .editorconfig -->
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>

    <!-- Artifact Output Configuration -->
    <!-- ArtifactsPath and ArtifactsTestResultsPath are defined in build/targets/artifacts/Artifacts.props -->
    <!-- ArtifactsPath (available since .NET 8 SDK) configured for .NET 10 SDK (see global.json). -->

    <!-- Output Configuration -->
    <!--
      Do NOT override OutputPath or IntermediateOutputPath: the SDK must compute them per-TFM
      so that multi-targeted inner builds don't race on shared files. Local dotnet build runs
      in parallel (ignores .rsp /m:1), making TFM isolation critical.
      With ArtifactsPath set, the SDK places outputs in artifacts/bin/<Project>/<config>_<tfm>/.
    -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>

    <!-- Enable SDK analyzers -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>

    <!-- Disable legacy Code Analysis -->
    <RunCodeAnalysis>false</RunCodeAnalysis>
    <CodeAnalysisRuleSet></CodeAnalysisRuleSet>

    <!-- Assembly Info - SDK-generated attributes -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyCompanyAttribute>true</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>true</GenerateAssemblyProductAttribute>
    <GenerateAssemblyCopyrightAttribute>true</GenerateAssemblyCopyrightAttribute>
    <GenerateAssemblyConfigurationAttribute>true</GenerateAssemblyConfigurationAttribute>
    <GenerateNeutralResourcesLanguageAttribute>true</GenerateNeutralResourcesLanguageAttribute>
    <GenerateAssemblyDescriptionAttribute>true</GenerateAssemblyDescriptionAttribute>
    <GenerateAssemblyTitleAttribute>true</GenerateAssemblyTitleAttribute>
    <GenerateTargetFrameworkAttribute>true</GenerateTargetFrameworkAttribute>

    <!-- Assembly attributes (replacing AssemblyInfo.Common.cs) -->
    <NeutralLanguage>en-US</NeutralLanguage>
    <CLSCompliant>true</CLSCompliant>
    <ComVisible>false</ComVisible>

    <!-- Package Metadata (for NuGet packages) -->
    <Authors>Richard Murillo</Authors>
    <Company>Qwiq Contributors</Company>
    <Product>Qwiq - Quick Work Item Queries</Product>
    <Copyright>Copyright (c) 2025 Qwiq Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rjmurillo/Qwiq</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rjmurillo/Qwiq.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Microsoft;Team Foundation Server;TFS;Azure DevOps;VSO;Visual Studio Online;Agile;WIT;Work Item Tracking;VSTS;TeamFoundation</PackageTags>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!--
    CI stability guardrail:
    - CS0006 can occur when multi-targeted inner builds run in parallel and a consumer touches
      a reference assembly before its producer finishes emitting it. /m:1 limits project-level
      parallelism but not inner-build parallelism. Disabling BuildInParallel (for inner MSBuild
      tasks) and reference assembly generation on CI mitigates the race at the cost of slightly
      longer builds.
  -->
  <PropertyGroup>
    <!-- Stop DispatchToInnerBuilds from parallelizing TFM inner builds -->
    <BuildInParallel>false</BuildInParallel>
    <MSBuildBuildInParallel>false</MSBuildBuildInParallel>

    <!-- Avoid ref-assembly emission races (CI rarely benefits from ref assemblies) -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>

    <!-- Disable Roslyn shared compilation (VBCSCompiler build server) to prevent file-locking
         races. This primarily guards local developer builds where dotnet build ignores the
         .rsp file's /m:1 setting and runs projects in parallel. CI explicitly passes /m:1
         but this belt-and-suspenders approach ensures reliability everywhere.
         Trade-off: slightly slower compilation (~2-5s) for deterministic success. -->
    <UseSharedCompilation>false</UseSharedCompilation>

    <!-- Ensure RID-specific builds don't collide (same rationale as TFM isolation above) -->
    <AppendRuntimeIdentifierToOutputPath>true</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!--
    Symbol Configuration:
    - Use embedded symbols for simplicity and enterprise firewall compatibility
    - Symbols are embedded in assemblies, no separate .snupkg needed
    - See ADR-012 for rationale
  -->
  <PropertyGroup>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <!-- Use embedded symbols (DotNet.ReproducibleBuilds default) for just-works debugging -->
    <DebugType>embedded</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Add Nerdbank.GitVersioning for all projects -->
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
    <!-- Microsoft.CodeAnalysis.NetAnalyzers is included in .NET SDK 5+ via EnableNETAnalyzers=true -->
  </ItemGroup>

  <!-- Source Link for all projects (even test projects benefit from source linking in debugging) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!--
    Reproducible Builds: .NET Foundation package that auto-configures deterministic build settings.
    - Auto-detects 11 CI platforms (GitHub Actions, Azure Pipelines, GitLab CI, Jenkins, etc.)
    - Sets ContinuousIntegrationBuild=true automatically on detected CI systems
    - Configures SourceLink for GitHub, GitLab, Azure DevOps, Bitbucket
    - Our explicit DebugType=embedded setting (line 116) takes precedence over the package default
    See: https://github.com/dotnet/reproducible-builds
  -->
  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="All" />
  </ItemGroup>

  <!--
    Enable building .NET Framework targets on non-Windows machines (Linux, macOS).
    Microsoft.NETFramework.ReferenceAssemblies provides the .NET Framework reference assemblies
    so Mono/.NET SDK can compile net472/net48/net481 without the Windows SDK installed.
    See: https://github.com/microsoft/dotnet-framework-reference-assemblies
  -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="All" />
    <!--
      System.Runtime facade resolves type-forwarding conflicts when TFS/Azure DevOps client
      libraries (targeting netstandard) are consumed in parallel builds. Use a direct Reference
      (not PackageReference) so it doesn't appear as a NuGet package dependency. It will appear
      as a frameworkAssembly in the nuspec, which is benign — System.Runtime is always in the
      GAC on .NET Framework.
    -->
    <Reference Include="System.Runtime" />
  </ItemGroup>

  <ItemGroup>

    <!-- InternalsVisibleTo for Castle DynamicProxy (used by Moq) - replaces AssemblyInfo.Common.cs -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2, " />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!-- Exclude AGENTS.md files from NuGet packages (for AI agents working on repo only) -->
  <ItemGroup>
    <None Remove="AGENTS.md" />
    <Content Remove="AGENTS.md" />
  </ItemGroup>
</Project>
