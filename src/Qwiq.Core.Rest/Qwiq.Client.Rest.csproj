<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-target: net472 for legacy, netstandard2.0 for TFS SDK compat, net8.0 for modern apps -->
    <TargetFrameworks>net472;netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>Qwiq.Client.Rest</RootNamespace>
    <AssemblyName>Qwiq.Client.Rest</AssemblyName>
    <Description>QWIQ REST Client - Azure DevOps REST-based Work Item client</Description>
    <PackageId>Qwiq.Client.Rest</PackageId>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Services.Client" />
    <PackageReference Include="Microsoft.TeamFoundationServer.Client" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.Threading.Tasks.Dataflow" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qwiq.Core\Qwiq.Core.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\AssemblyInfo.Common.cs" Link="Properties\AssemblyInfo.Common.cs" />
  </ItemGroup>
</Project>
