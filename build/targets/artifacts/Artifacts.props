<Project>
  <PropertyGroup>
    <!-- Centralized artifact output paths (ArtifactsPath available since .NET 8 SDK) -->
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$(RepoRoot)artifacts</ArtifactsPath>
    <ArtifactsTestResultsPath Condition="'$(ArtifactsTestResultsPath)' == ''">$(ArtifactsPath)\TestResults</ArtifactsTestResultsPath>
  </PropertyGroup>
</Project>

